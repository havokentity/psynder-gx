//
// engine/render/post/shaders/ui_composite.slang
//
// Lane 11 — Final UI compositing pass (DESIGN §10.6).
//
// Composites two UI overlay atlases onto the tonemapped / upscaled scene:
//
//   1. scene_color  — tonemapped + upscaled scene (sRGB, from tonemap pass)
//   2. ui_rml_atlas — RmlUi player HUD / menu atlas (pre-multiplied alpha,
//                     generated by lane 21; may be null if RmlUi is inactive)
//   3. ui_imm_atlas — In-viewport immediate-mode overlay (perf graphs,
//                     gizmos, debug viz — lane 21 ui-imm; may be null)
//
// Blend order: scene (opaque) → ui_rml (alpha-over) → ui_imm (alpha-over).
// Both UI layers use pre-multiplied alpha so the blend is a simple
//   out = src + dst * (1 - src.a)
// which is exact with no rounding in the float path.
//
// Integration notes for lane 21 (ui):
//   - Both atlases are RGBA8 (sRGB) textures, updated by lane 21 each frame
//     before PostProcess::run_frame() is called.
//   - Pass nullptr / invalid handle for an atlas that is not active; this
//     shader treats a missing atlas as fully transparent (identity).
//   - The atlases are expected to match the output_width × output_height in
//     PostDesc (post-upscale resolution).  If they differ, the shader bilinear-
//     samples to fit — but pixel-perfect UI requires the atlases to match.
//
// Slang compiles to SPIR-V (Vulkan) and Metal IR (macOS) via psy::shader.

// ── Textures ──────────────────────────────────────────────────────────────
Texture2D<float4>   t_scene;        // tonemap output (sRGB)
Texture2D<float4>   t_ui_rml;       // RmlUi atlas (pre-mult alpha, sRGB)
Texture2D<float4>   t_ui_imm;       // immediate overlay atlas (pre-mult alpha)
SamplerState        s_linear;       // bilinear clamp

// ── Params ─────────────────────────────────────────────────────────────────
struct UICompositeParams
{
    uint has_ui_rml;   // 1 if t_ui_rml is bound with real content
    uint has_ui_imm;   // 1 if t_ui_imm is bound with real content
    float _pad0;
    float _pad1;
};

ParameterBlock<UICompositeParams> g_ui;

// ── Helpers ───────────────────────────────────────────────────────────────

// Pre-multiplied alpha-over: Porter-Duff "over" with PM src.
float4 alpha_over_pm(float4 dst, float4 src)
{
    return src + dst * (1.0 - src.a);
}

// ── Vertex shader (full-screen triangle) ─────────────────────────────────
struct VSOut
{
    float4 pos : SV_Position;
    float2 uv  : TEXCOORD0;
};

[shader("vertex")]
VSOut vs_ui_composite(uint vid : SV_VertexID)
{
    float2 pos2 = float2((vid & 1u) ? 3.0 : -1.0,
                         (vid & 2u) ? 3.0 : -1.0);
    VSOut o;
    o.pos = float4(pos2, 0.0, 1.0);
    o.uv  = pos2 * float2(0.5, -0.5) + 0.5;
    return o;
}

// ── Fragment shader ───────────────────────────────────────────────────────
[shader("fragment")]
float4 fs_ui_composite(VSOut i) : SV_Target
{
    float4 result = t_scene.Sample(s_linear, i.uv);

    if (g_ui.has_ui_rml != 0u)
    {
        float4 rml = t_ui_rml.Sample(s_linear, i.uv);
        result = alpha_over_pm(result, rml);
    }

    if (g_ui.has_ui_imm != 0u)
    {
        float4 imm = t_ui_imm.Sample(s_linear, i.uv);
        result = alpha_over_pm(result, imm);
    }

    return result;
}
