<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Forces the process ANSI code page to UTF-8 (Windows 10 1903+).

  catch_discover_tests records each TEST_CASE name as UTF-8 and ctest passes it
  back as a command-line filter. Without UTF-8 argv, the CRT decodes that filter
  via the legacy ANSI code page, mangling non-ASCII names (e.g. "deg" sign, em
  dash) so Catch2 matches nothing and the test is reported as failed. With UTF-8
  argv the filter bytes match the recorded names exactly.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
